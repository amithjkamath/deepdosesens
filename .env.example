# Copy to .env and edit. All settings are optional; each falls back to a directory
# inside the repository. See ARTIFACTS.md for the archive layout.

# Where the zip archives live. Point these at your copies (an iCloud/Drive folder,
# an external disk, a share) and run scripts/fetch_artifacts.sh to unpack what the
# code needs. The ISBI archive alone is enough for the ISBI results and the dose
# sweep videos; the Cancers archive adds the out-of-distribution cases and the
# three retrained models.
#DEEPDOSESENS_ISBI_ARCHIVE=/Users/you/Documents/2022-11-ISBI/artifacts
#DEEPDOSESENS_CANCERS_ARCHIVE=/Users/you/Documents/2023-08-Cancers/artifacts

# Where the unpacked planning CTs, contours and reference dose plans live.
# Default: <repo>/data
#DEEPDOSESENS_DATA=/mnt/big-disk/deepdosesens/data

# Where the dose-predictor weights live.
# Default: <repo>/checkpoints
#DEEPDOSESENS_CHECKPOINTS=/mnt/big-disk/deepdosesens/checkpoints

# Where the predicted dose volumes live, one directory per training run or model.
# Default: <repo>/predictions
#DEEPDOSESENS_PREDICTIONS=/mnt/big-disk/deepdosesens/predictions

# Where reproduced tables, figures and videos are written.
# Default: <repo>/results
#DEEPDOSESENS_RESULTS=/mnt/big-disk/deepdosesens/results
